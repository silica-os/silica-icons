{
  "format": 2,
  "id": "terminal",
  "name": "Terminal",
  "kind": "app",
  "keyline": "square",
  "background": {
    "light": {
      "gradient": [
        "#28282c",
        "#08080a"
      ]
    },
    "dark": {
      "gradient": [
        "#1e1e22",
        "#040405"
      ]
    }
  },
  "layers": [
    {
      "id": "output",
      "role": "detail",
      "min_size": 32,
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    },
    {
      "id": "prompt",
      "role": "body",
      "clear": {
        "mode": "light"
      },
      "tinted": {
        "mode": "light"
      }
    },
    {
      "id": "cursor",
      "role": "detail",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "accent"
      }
    }
  ],
  "fallback": {
    "light": "icon.png",
    "dark": "icon-dark.png"
  }
}
