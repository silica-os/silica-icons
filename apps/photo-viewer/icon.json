{
  "format": 2,
  "id": "photo-viewer",
  "name": "Photo Viewer",
  "kind": "app",
  "keyline": "square",
  "background": {
    "light": {
      "gradient": [
        "#f7f8fd",
        "#e2e6f2"
      ]
    },
    "dark": {
      "gradient": [
        "#3a3a40",
        "#151518"
      ]
    }
  },
  "layers": [
    {
      "id": "photo",
      "role": "body",
      "clear": {
        "mode": "ramp",
        "luma": [
          10,
          125
        ]
      },
      "tinted": {
        "mode": "ramp"
      },
      "dark": {
        "clear": {
          "luma": null
        }
      }
    },
    {
      "id": "magnifier",
      "role": "body",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    },
    {
      "id": "lens",
      "role": "body",
      "clear": {
        "mode": "glass"
      },
      "tinted": {
        "mode": "ramp"
      }
    },
    {
      "id": "lens-highlight",
      "role": "highlight",
      "clear": {
        "mode": "keep",
        "opacity": 0.6
      },
      "tinted": {
        "mode": "keep",
        "opacity": 0.6
      }
    },
    {
      "id": "label",
      "role": "detail",
      "min_size": 64,
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    }
  ],
  "fallback": {
    "light": "icon.png",
    "dark": "icon-dark.png"
  }
}
