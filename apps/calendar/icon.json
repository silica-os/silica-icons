{
  "format": 2,
  "id": "calendar",
  "name": "Calendar",
  "kind": "app",
  "keyline": "full",
  "background": {
    "light": {
      "gradient": [
        "#ffffff",
        "#dde3ec"
      ]
    },
    "dark": {
      "gradient": [
        "#3a3a3c",
        "#141416"
      ]
    }
  },
  "layers": [
    {
      "id": "date-disc",
      "role": "body",
      "clear": {
        "mode": "ramp",
        "luma": [
          10,
          170
        ]
      },
      "tinted": {
        "mode": "accent"
      },
      "dark": {
        "clear": {
          "luma": null
        }
      }
    },
    {
      "id": "disc-specular",
      "role": "highlight",
      "clear": {
        "mode": "keep",
        "opacity": 0.6
      },
      "tinted": {
        "mode": "keep",
        "opacity": 0.6
      }
    },
    {
      "id": "month",
      "role": "dynamic",
      "clear": {
        "mode": "ramp",
        "luma": [
          20,
          160
        ]
      },
      "tinted": {
        "mode": "accent"
      },
      "dark": {
        "clear": {
          "luma": null
        }
      },
      "dynamic": {
        "kind": "calendar-month",
        "font": "Inter",
        "size": 190,
        "weight": 900,
        "tracking": 0,
        "color": "#f5222f",
        "dark_color": "#ff5a62",
        "box": [
          212,
          144,
          600,
          230
        ],
        "case": "upper",
        "format": "short",
        "refresh": "midnight"
      }
    },
    {
      "id": "day",
      "role": "dynamic",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      },
      "dark": {
        "clear": {
          "luma": [
            20,
            80
          ]
        }
      },
      "dynamic": {
        "kind": "calendar-day",
        "font": "Inter",
        "size": 308,
        "weight": 700,
        "tracking": 0,
        "color": "#ffffff",
        "dark_color": "#f2f4f8",
        "box": [
          212,
          426,
          600,
          372
        ],
        "refresh": "midnight"
      }
    }
  ],
  "fallback": {
    "light": "icon.png",
    "dark": "icon-dark.png"
  }
}
