{
  "format": 2,
  "id": "apps",
  "name": "Apps",
  "kind": "app",
  "keyline": "square",
  "background": {
    "light": {
      "gradient": [
        "#ffffff",
        "#dde3ec"
      ]
    },
    "dark": {
      "gradient": [
        "#3a3a3c",
        "#141416"
      ]
    }
  },
  "layers": [
    {
      "id": "search-bar",
      "role": "body",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    },
    {
      "id": "tiles",
      "role": "body",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    },
    {
      "id": "tile-specular",
      "role": "highlight",
      "clear": {
        "mode": "keep",
        "opacity": 0.6
      },
      "tinted": {
        "mode": "keep",
        "opacity": 0.6
      }
    },
    {
      "id": "search",
      "role": "detail",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    },
    {
      "id": "glyphs",
      "role": "detail",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    }
  ],
  "fallback": {
    "light": "icon.png",
    "dark": "icon-dark.png"
  }
}
