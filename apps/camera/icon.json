{
  "format": 2,
  "id": "camera",
  "name": "Camera",
  "kind": "app",
  "keyline": "full",
  "background": {
    "light": {
      "gradient": [
        "#34353c",
        "#0e0f12"
      ]
    },
    "dark": {
      "gradient": [
        "#25262b",
        "#070708"
      ]
    }
  },
  "layers": [
    {
      "id": "lens-ring",
      "role": "body",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    },
    {
      "id": "lens",
      "role": "body",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      },
      "dark": {
        "clear": {
          "luma": [
            20,
            100
          ]
        }
      }
    },
    {
      "id": "lens-specular",
      "role": "highlight",
      "clear": {
        "mode": "keep",
        "opacity": 0.6
      },
      "tinted": {
        "mode": "keep",
        "opacity": 0.6
      }
    },
    {
      "id": "flash",
      "role": "body",
      "clear": {
        "mode": "ramp"
      },
      "tinted": {
        "mode": "ramp"
      }
    }
  ],
  "fallback": {
    "light": "icon.png",
    "dark": "icon-dark.png"
  }
}
